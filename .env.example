# Copy to .env.local (dev) or .env.production (on the host). Both are gitignored.
# Only NAMES belong in this file — never real secret values.

# SQLite database file path. In Docker this is the mounted volume, e.g.
# /app/data/app.db; in dev it defaults to ./data/app.db if unset.
DATABASE_URL=./data/app.db

# Enable the in-process scheduler in dev (production enables it automatically).
ENABLE_SCHEDULER=false

# Example secret — set a real value in .env.local / .env.production, not here.
AUTH_SECRET=

# Deploy-time (used by docker-compose.prod.yml / scripts/deploy.sh):
# APP_PORT=3000
# TZ=UTC
