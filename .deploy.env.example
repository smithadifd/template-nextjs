# Copy to .deploy.env (gitignored). Overrides the placeholders in scripts/deploy.sh.
# No secrets — just deploy targets. Real secrets live in .env.production on the host.

DEPLOY_REMOTE=your-host                 # replace with a configured SSH alias
DEPLOY_REMOTE_PATH=/path/to/app         # project directory on the host
# DEPLOY_REMOTE_PRE_CMD='export PATH=/usr/local/bin:/usr/syno/bin:$PATH'  # default with docker-compose; override for your host
# DEPLOY_REPO_URL=git@github.com:you/your-repo.git
# DEPLOY_COMPOSE_FILE=docker-compose.prod.yml
# DEPLOY_COMPOSE_CMD='docker compose'    # override the Synology DSM default (docker-compose) for hosts with Compose v2
DEPLOY_APP_PORT=3000                    # host port from docker-compose.prod.yml
# DEPLOY_HEALTH_PATH=/health
